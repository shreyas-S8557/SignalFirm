# --- Twenty CRM ---
TWENTY_BASE_URL=http://localhost:3000
TWENTY_API_KEY=replace-me
TWENTY_TIMEOUT_SECONDS=30

# Optional: push job progress into the ResearchJob/EnrichmentJob records
# inside Twenty itself, via the Twenty App's HTTP-route logic function
# (see ../twenty-app-crm-sync/src/logic-functions/job-progress-webhook.ts).
# Leave blank to track progress only via this service's own /jobs API.
TWENTY_PROGRESS_WEBHOOK_URL=
TWENTY_WEBHOOK_SHARED_SECRET=replace-me

# Optional: push Conversation Intelligence results into Twenty as
# ConversationSignal records, via conversation-signal-webhook.ts. Leave
# blank to still run analysis and return it in the API response, just
# without writing it back into the CRM. Reuses TWENTY_WEBHOOK_SHARED_SECRET
# above for auth (same secret is used bidirectionally -- see
# ../twenty-app/src/application.config.ts). This is also the secret the
# Twenty App's reply-intelligence-trigger.ts sends when it calls INTO this
# service's own /conversation/analyze endpoint.
TWENTY_CONVERSATION_SIGNAL_WEBHOOK_URL=

# --- Conversation Intelligence LLM backend ---
# Any OpenAI-compatible /chat/completions endpoint works here -- pick
# whichever free-tier-friendly provider you have a key for. Examples:
#   Groq:        https://api.groq.com/openai/v1   (model e.g. llama-3.1-8b-instant)
#   OpenRouter:  https://openrouter.ai/api/v1      (many free models, e.g. a ":free" suffix)
#   Local Ollama: http://localhost:11434/v1         (model e.g. qwen2.5:3b, no API key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
# Set to false if your chosen provider rejects the `response_format` field.
LLM_SUPPORTS_JSON_MODE=true

# --- Recommendation Engine daily digest ---
# When recommendations_scheduler_main.py fires the digest each day. Ignored
# if you trigger it yourself instead via POST /recommendations/daily-digest/send.
DIGEST_SCHEDULE_HOUR=7
DIGEST_SCHEDULE_MINUTE=0
DIGEST_TIMEZONE=UTC

# Optional: email delivery via plain SMTP. Leave DIGEST_EMAIL_TO blank to
# skip this transport.
DIGEST_SMTP_HOST=
DIGEST_SMTP_PORT=587
DIGEST_SMTP_USER=
DIGEST_SMTP_PASSWORD=
DIGEST_SMTP_FROM=
DIGEST_SMTP_USE_TLS=true
DIGEST_EMAIL_TO=

# Optional: Slack delivery via an incoming webhook URL. Leave blank to skip.
DIGEST_SLACK_WEBHOOK_URL=

# Only used if neither of the above is configured, so a fresh deploy still
# produces a visible artifact instead of a silent no-op.
DIGEST_FALLBACK_FILE_PATH=./daily_digest.md

# --- Phase 7: Workflow Automation ---
# Off by default -- chains Import -> Enrichment automatically for every
# newly-synced company within the same import job, rather than requiring a
# human (or the enrichment scheduler) to trigger it separately. See
# scrapegraph_worker/workflow/ and worker/README.md's Workflow Automation
# section for exactly what is and isn't automated beyond this hand-off.
AUTO_ENRICH_ON_IMPORT=false

# --- Phase 5: Research Automation ---
# Chains Enrichment -> Research automatically after an import. Only has an
# effect when AUTO_ENRICH_ON_IMPORT is also true (research requires
# enrichment as grounding) and when LLM_BASE_URL/LLM_MODEL are set.
# Separate flag because research costs LLM tokens per company, which
# enrichment largely doesn't. Trigger it yourself instead via
# POST /companies/{id}/research or POST /companies/{id}/workflow/advance-all.
AUTO_RESEARCH_AFTER_ENRICHMENT=false

# --- Phase 4: Company Enrichment automatic sweep ---
# Disabled by default -- an unattended website-crawl sweep is a bigger
# default footprint than the rest of this service has. Set to true to run
# enrichment_scheduler_main.py's daily sweep of companies that are missing
# enrichment or overdue for it. To trigger enrichment on your own schedule
# instead, leave this false and hit POST /enrichment/jobs yourself.
ENRICHMENT_SCHEDULE_ENABLED=false
ENRICHMENT_SCHEDULE_HOUR=3
ENRICHMENT_SCHEDULE_MINUTE=0
ENRICHMENT_TIMEZONE=UTC
# A company is due for (re-)enrichment if it's never been enriched, or its
# last enrichment is older than this many days.
ENRICHMENT_STALE_AFTER_DAYS=30
# Safety cap on how many companies one scheduled sweep will crawl.
ENRICHMENT_MAX_PER_RUN=50

# --- Optional paid firmographic data providers (see enrichment/providers/) ---
# Both empty by default -- enrichment behaves exactly as before until you
# set one. No Clearbit setting: standalone Clearbit API access was cut off
# for non-HubSpot customers when HubSpot folded it into Breeze
# Intelligence, so there's no self-serve key to configure here the way
# there is for Apollo/PDL.
APOLLO_API_KEY=
PDL_API_KEY=
DATA_PROVIDER_TIMEOUT_SECONDS=15
# Comma-separated, first match wins.
DATA_PROVIDER_PRIORITY=apollo,people_data_labs

# --- Queue ---
REDIS_URL=redis://localhost:6379/0
SCRAPE_QUEUE_NAME=scrapegraph-jobs
SCRAPE_JOB_TIMEOUT_SECONDS=3600
SCRAPE_JOB_RETRY_LIMIT=2

# --- Job store ---
JOB_STORE_URL=sqlite:///./scrapegraph_jobs.db

# --- Misc ---
SCRAPE_DRY_RUN=false

# --- Phase 8: optional shared-secret on Twenty-proxied read/action endpoints ---
# Empty by default -- these endpoints stay open the way they always have
# for the Phase 9 standalone frontend. Set this to require a matching
# X-Api-Key header (the Twenty-app proxy logic-functions send it -- see
# ../twenty-app/.env.example's CRM_SYNC_WORKER_API_KEY). Defense-in-depth
# on top of, not instead of, the Twenty-side routes' own user-session auth.
WORKER_API_KEY=

# --- ICP Scoring ---
# Path to the rubric YAML (weights + target/disqualifying lists). Leave
# unset to use the bundled default at worker/data/icp_rubric.yaml.
ICP_RUBRIC_PATH=

# --- Phase 6: AI Outbound Messaging ---
# How generated drafts introduce the sender -- shows up directly in
# LinkedIn/email copy, so set these to something real before drafting.
OUTBOUND_SENDER_NAME=
OUTBOUND_SENDER_COMPANY=
OUTBOUND_PRODUCT_ONE_LINER=

# SMTP for the one channel this service can actually send on (email).
# Separate from DIGEST_SMTP_* above -- prospect-facing mail often needs a
# different sending domain/account than an internal digest.
OUTBOUND_SMTP_HOST=
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_USER=
OUTBOUND_SMTP_PASSWORD=
OUTBOUND_SMTP_FROM=
OUTBOUND_SMTP_USE_TLS=true

# Off by default -- drafting always runs automatically once a company is
# ICP-scored, but actually emailing a prospect is opt-in. LinkedIn/call
# steps are NEVER auto-sent regardless of this flag -- see
# outbound/send/linkedin_adapter.py.
OUTBOUND_AUTO_SEND_EMAIL=false
# Even with auto-send on, defaults to logging instead of really sending --
# flip to false only once you've verified OUTBOUND_SMTP_* against a real
# (ideally non-prospect) test address.
OUTBOUND_DRY_RUN=true
OUTBOUND_MAX_SEQUENCE_STEPS_PER_RUN=50

# --- Phase 9: Production Readiness ---
# LOG_FORMAT=json is recommended for any real deployment (ingestible by a
# log aggregator); "text" (the default) is easier to read locally.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Optional -- error reporting via Sentry, only activates if both this is
# set AND sentry-sdk is installed (see requirements.txt).
SENTRY_DSN=
# In-process rate limiting (see scrapegraph_worker/observability.py). Set
# to 0 to disable if a fronting proxy/gateway already rate-limits.
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
