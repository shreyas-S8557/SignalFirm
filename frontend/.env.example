# Base URL of the running worker service (see ../worker/README.md), e.g.
# http://localhost:8000 for a local `uvicorn scrapegraph_worker.api:app --reload`.
#
# Left unset, the app falls back to realistic fixture data (src/lib/fixtures.ts)
# so the whole dashboard is browsable on its own -- every page shows a
# "Sample data" badge instead of "Live" when it's doing this.
VITE_API_BASE_URL=http://localhost:8000
